{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ready-to-grow-demo",
  "main": "worker/demo-worker.js",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "demo",
    "LIFF_ID": ""
  }
}
